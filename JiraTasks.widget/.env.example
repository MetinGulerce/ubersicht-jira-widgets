# Kendi Jira bilgilerinizle doldurun.
# İsterseniz bu dosyayı ~/.jira_env olarak kopyalayın,
# isterseniz bu klasörde .env adıyla kullanın.

JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Opsiyonel:
# Bos birakirsaniz sadece kendi aktif gorevleriniz listelenir.
# Virgulle account ID girerseniz JiraTasks ve JiraTeamRadar takim moduna gecer.
JIRA_TEAM_ACCOUNT_IDS=""

# JiraTasks gorunum modu:
# developer = mevcut teknik gorunum
# product   = RFT ve TEST gruplarini ayri ust bloklar olarak gosterir
JIRA_TASKS_VIEW_MODE="developer"
